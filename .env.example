# =====================================================
# INSOLVENTIC — Environment Variables Template
# =====================================================
# Copia este archivo como `.env` y rellena con valores reales.
# NUNCA commitees `.env` al repositorio.
#
# En Vercel las variables se gestionan en el dashboard
# (Project → Settings → Environment Variables) y se sincronizan
# vía `npx vercel pull`.
# =====================================================


# =====================================================
# BASE DE DATOS (una por centro de conciliación)
# =====================================================
# Formato: postgresql://user:pass@host:port/db?sslmode=verify-full
# Se recomienda CockroachDB serverless o PostgreSQL con TLS.
DATABASE_URL_ARMONIA="postgresql://your-user:your-password@your-host:26257/insolventic_dev_armonia?sslmode=verify-full"
DATABASE_URL_CONSTRUCTORES_PAZ="postgresql://your-user:your-password@your-host:26257/insolventic_dev_constructores?sslmode=verify-full"

# Fallback genérico (si no se provee uno específico por tenant).
# Puede apuntar a cualquiera de los dos para development.
DATABASE_URL="${DATABASE_URL_ARMONIA}"


# =====================================================
# JWT AUTENTICACIÓN
# =====================================================
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mínimo 32 caracteres. NO reusar entre access y refresh.
# Access token: 24h. Refresh token: 7d (hardened).
JWT_SECRET="your-jwt-secret-key-here-minimum-32-characters"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-key-here-minimum-32-characters"


# =====================================================
# EMAIL (Gmail SMTP)
# =====================================================
# Cuenta Gmail para envío de emails (reset password, notificaciones).
SMTP_USER="insolvenic@gmail.com"
# App password de 16 caracteres generada en:
# https://myaccount.google.com/apppasswords
SMTP_PASSWORD="your-16-character-app-password"


# =====================================================
# NEXT.JS
# =====================================================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-key-here"

# URL pública de la app (usada en links de emails).
# Producción: https://insolventic.vercel.app
APP_URL="http://localhost:3000"

# Entorno público expuesto al cliente (para badge de versión).
# Valores: development | staging | production
NEXT_PUBLIC_APP_ENV="development"


# =====================================================
# GOOGLE DRIVE (una credencial por centro si operan separado)
# =====================================================
# Crear proyecto en https://console.cloud.google.com
# Habilitar Drive API + crear OAuth 2.0 Client ID.
GOOGLE_DRIVE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_DRIVE_CLIENT_SECRET="your-google-drive-client-secret"

# ID de la carpeta raíz donde se almacenarán las subcarpetas por caso.
# Obtener de la URL: drive.google.com/drive/folders/<ESTE_ID>
GOOGLE_DRIVE_FOLDER_ID="your-google-drive-folder-id"

# Redirect URI registrado en la consola de Google.
GOOGLE_DRIVE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Refresh token obtenido con el flujo OAuth inicial.
# Ver docs/ARQUITECTURA.md sección 9 para rotación.
GOOGLE_DRIVE_REFRESH_TOKEN="your-google-drive-refresh-token"


# =====================================================
# VERCEL (opcional, solo si deployas desde local)
# =====================================================
VERCEL_OIDC_TOKEN="your-vercel-oidc-token"


# =====================================================
# OBSERVABILIDAD (OPCIONAL)
# =====================================================
# Sentry DSN: si está vacío, Sentry queda como no-op.
# Obtener en https://sentry.io → Project Settings → Client Keys (DSN).
# NEXT_PUBLIC_ expone el DSN al bundle del cliente (lo espera Sentry).
NEXT_PUBLIC_SENTRY_DSN=""
# DSN server-side (puede ser el mismo que el público).
SENTRY_DSN=""
# Token para upload de source maps en build (opcional pero recomendado).
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Vercel Analytics y Speed Insights se activan automáticamente al desplegar
# en Vercel — no requieren variables. En local quedan inertes.


# =====================================================
# ALERTAS PROACTIVAS (CRON)
# =====================================================
# Token requerido por /api/cron/alerts para prevenir triggers no autorizados.
# Vercel Cron lo inyecta automáticamente si está seteado en el proyecto.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Ventana de anticipación para alertas de audiencias (horas). Default: 48.
ALERTS_HEARING_LOOKAHEAD_HOURS="48"

# Ventana de deduplicación entre ejecuciones del cron (horas). Evita spam
# si el cron corre más de una vez al día. Default: 20.
ALERTS_DEDUPE_WINDOW_HOURS="20"

# Si "true", además de la notificación in-app se envía email al operador.
# Requiere SMTP_USER / SMTP_PASSWORD configurados. Default: desactivado.
ALERTS_EMAIL_ENABLED="false"


# =====================================================
# RATE LIMITING DISTRIBUIDO (UPSTASH REDIS)
# =====================================================
# Sin estas dos vars el rate limiting cae al fallback in-memory, que en
# serverless NO protege (cada instancia tiene su propio contador). En
# producción son obligatorias.
#
# Crear una base gratuita en https://console.upstash.com → Redis → Create
# Database, y copiar de la pestaña "REST API":
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


# =====================================================
# TESTING (solo CI / local)
# =====================================================
# En CI se expone como env inline en pr.yml, pero puedes definirla local
# si quieres correr `npx jest` sin cargar un .env real.
# JWT_SECRET="test-secret-key-for-unit-tests-only"
