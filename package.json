    "jose": "^6.1.0",
    "libreoffice-convert": "^1.7.0",
    "lucide-react": "^0.545.0",
    "next": "^15.5.12",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.9",
    "pizzip": "^3.2.0",
    "puppeteer-core": "^24.37.2",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.65.0",
    "recharts": "^3.8.0",
