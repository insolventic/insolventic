# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# Playwright (npm run test:e2e) escribe estos dos directorios en el repo;
# ninguno de los dos estaba ignorado, así que cualquiera que corriera la
# suite en local quedaba con un directorio sin trackear ensuciando `git status`.
/test-results/
/playwright-report/

# OS artifacts
nul
.DS_Store
Thumbs.db

# temp/dev files
_transform.*
plan.md
*.report.md

# Datos de contacto reales (el repo es público): ver docs/RUNBOOK.md §0.1.
# La plantilla commiteada es docs/CONTACTOS.example.md.
docs/*.local.md

# Claude / AI artifacts
.claude/

# Thesis / academic artifacts (not part of the product)
# These files live in the working directory for the author's convenience
# but must never ship with the codebase.
/*.docx
/*.pptx
/Carta_Aceptacion_*.docx
/DT - INSOLVENTIC*.docx
/INSOLVENTIC_Presentacion.pptx
/Diagrama_AS-IS_Insolventic.png
/Diagrama_TO-BE_Insolventic.png

# Documentos internos del autor (costos, mensajes al cliente, borradores de PR):
# no forman parte del repositorio entregable.
/docs/ESTIMACION_COSTOS_INFRAESTRUCTURA.md
/docs/MENSAJE_CLIENTE_COSTOS.md
/docs/PR_MANUAL_USUARIO.md

# Copia local de CLAUDE.md para otros agentes: no se versiona.
/AGENTS.md

# Firmas y sellos: se cargan en la base por centro (docs/RUNBOOK.md §7.3) y no
# se versionan nunca; el repositorio es público. `privado/` es la carpeta local
# sugerida para tenerlas a mano. El check "Sin firmas ni sellos" de pr.yml
# rechaza el PR si alguna entra igual.
/privado/
[Ff]irma*.png
[Ff]irma*.jpg
[Ff]irma*.jpeg
[Ss]ello*.png
[Ss]ello*.jpg
[Ss]ello*.jpeg
# El logo de firma de Constructores de Paz es un sello.
/templates/branding/constructores-paz/logo-firma.*
