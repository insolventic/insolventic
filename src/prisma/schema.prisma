  procesosEjecutivosVigentes   Boolean   @default(false) @map("procesos_ejecutivos_vigentes")

  // ============================================================
  // FORMULARIO DEFINITIVO - Sección VIII: Declaraciones del Deudor
  // ============================================================
  declaracionVeracidadInformacion      Boolean @default(false) @map("declaracion_veracidad_informacion")
  manifestacionBuenaFe                 Boolean @default(false) @map("manifestacion_buena_fe")
  manifestacionNoOcultamientoBienes    Boolean @default(false) @map("manifestacion_no_ocultamiento_bienes")
  autorizacionNotificacionesCorreo     Boolean @default(false) @map("autorizacion_notificaciones_correo")
  autorizacionConsultaCentralesRiesgo  Boolean @default(false) @map("autorizacion_consulta_centrales_riesgo")
  autorizacionTratamientoDatos         Boolean @default(false) @map("autorizacion_tratamiento_datos")
  declaracionNoOmisiones               Boolean @default(false) @map("declaracion_no_omisiones")
  declaracionConocimientoNorma         Boolean @default(false) @map("declaracion_conocimiento_norma")

  // ============================================================
  // CONCILIACIÓN - Campos específicos del servicio de conciliación
  // ============================================================
  concAsunto                           String?   @map("conc_asunto")
  concDescripcionHechos                String?   @map("conc_descripcion_hechos") @db.Text
  concPretensiones                     String?   @map("conc_pretensiones") @db.Text
  concCuantiaPesos                     String?   @map("conc_cuantia_pesos")
  concCuantiaLetras                    String?   @map("conc_cuantia_letras")
  concRelacionPruebas                  String?   @map("conc_relacion_pruebas") @db.Text
  concOtroMedioComunicacion            String?   @map("conc_otro_medio_comunicacion")
  concFechaNacimiento                  String?   @map("conc_fecha_nacimiento")
  // Convocante (solicitante)
  concConvocanteName                   String?   @map("conc_convocante_name")
  concConvocanteTipoId                 String?   @map("conc_convocante_tipo_id")
  concConvocanteId                     String?   @map("conc_convocante_id")
  concConvocanteDireccion              String?   @map("conc_convocante_direccion")
  concConvocanteCiudad                 String?   @map("conc_convocante_ciudad")
  concConvocanteCorreo                 String?   @map("conc_convocante_correo")
  concConvocanteCel                    String?   @map("conc_convocante_cel")
  // Convocado (contraparte)
  concConvocadoName                    String?   @map("conc_convocado_name")
  concConvocadoTipoId                  String?   @map("conc_convocado_tipo_id")
  concConvocadoId                      String?   @map("conc_convocado_id")
  concConvocadoDireccion               String?   @map("conc_convocado_direccion")
  concConvocadoCiudad                  String?   @map("conc_convocado_ciudad")
  concConvocadoCorreo                  String?   @map("conc_convocado_correo")
  concConvocadoCel                     String?   @map("conc_convocado_cel")
  // Representante legal
  concRepLegalName                     String?   @map("conc_rep_legal_name")
  concRepLegalTipoId                   String?   @map("conc_rep_legal_tipo_id")
  concRepLegalId                       String?   @map("conc_rep_legal_id")
  concRepLegalDireccion                String?   @map("conc_rep_legal_direccion")
  concRepLegalCiudad                   String?   @map("conc_rep_legal_ciudad")
  concRepLegalCorreo                   String?   @map("conc_rep_legal_correo")
