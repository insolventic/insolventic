  fechaCesacionPagos           DateTime? @map("fecha_cesacion_pagos")
  numeroAcreedoresActual       Int?      @map("numero_acreedores_actual")
  porcentajePasivoEnMora       Decimal?  @map("porcentaje_pasivo_en_mora")
