  concApoderadoConvocadoTipoId         String?   @map("conc_apoderado_convocado_tipo_id")
  concApoderadoConvocadoId             String?   @map("conc_apoderado_convocado_id")
  concApoderadoConvocadoCorreo         String?   @map("conc_apoderado_convocado_correo")
  concApoderadoConvocadoCel            String?   @map("conc_apoderado_convocado_cel")
  concApoderadoConvocadoTP             String?   @map("conc_apoderado_convocado_tp")
  // Conciliadora
