  patrimonioTotalEstimado      Decimal?  @map("patrimonio_total_estimado")
  pasivoTotalEstimado          Decimal?  @map("pasivo_total_estimado")

  // ============================================================
  // FORMULARIO DEFINITIVO - Sección IV: Declaración de Cesación de Pagos
  // ============================================================
