generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  description     String?
  logoUrl         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  cases               Case[]
  debtors             Debtor[]
  creditors           Creditor[]
  users               User[]
  roles               Role[]
  permissions         Permission[]
  rolePermissions     RolePermission[]
  notifications       Notification[]
  documents           Document[]
  documentTemplates   DocumentTemplate[]
  documentsFromDrive  DocumentFromDrive[]
  passwordResetTokens PasswordResetToken[]
  contacts            Contact[]
  legalProcesses      LegalProcess[]
  debts               Debt[]
  assets              Asset[]
  libranzas           Libranza[]
  suspendedServices   SuspendedService[]
  dependents          Dependent[]
}

model Case {
  id                      String         @id @default(cuid())
  caseNumber              String         
  debtorName              String
  type                    String
  totalDebt               Decimal
  creditors               Int
  createdDate             DateTime       @default(now())
  hearingDate             DateTime?
  phase                   String?
  causes                  String[]       @default([])
  debtorId                String
  operatorId              String
  tenantId                String
  tramite                 String?
  filingDate              DateTime?
  debtorIdNumber          String?
  convened                String?
  attorney                String?
  owedCapital             Decimal?
  designatedOperator      String?
  designationDate         DateTime?
  positionAcceptanceDate  DateTime?
  inadmissionDate         DateTime?
  admissionDate           DateTime?
  firstHearingDate        DateTime?
  firstHearingTime        String?
  rejection               Boolean        @default(false)
  withdrawal              Boolean        @default(false)
  hasLegalProcesses       Boolean        @default(false)
  courtNumber             String?
  city                    String?
  processType             String?
  plaintiff               String?
  judicialFileNumber      String?
  suspensionDate          DateTime?
  resultDeliveryDate      DateTime?
  resultType              String?
  resultDate              DateTime?
  siccacNumber            String?
  riskCenterCommunication Boolean        @default(false)
  
  // Ámbito de Aplicación
  applicantScope          String[]       @default([])
  
  // Propuesta de Pago
  gracePeriodRequested    Boolean        @default(false)
  gracePeriodMonths       Int?
  paymentInKind           Boolean        @default(false)
  paymentInKindDescription String?
  assetSaleAuthorized     Boolean        @default(false)
  assetSaleDescription    String?
  cashFlowPayment         Boolean        @default(false)
  paymentTermMonths       Int?
  monthlyPaymentAmount    Decimal?
  variablePayment         Decimal?
  extraordinaryPayment    Boolean        @default(false)
  extraordinaryPaymentDate String?
  capitalReduction        Boolean        @default(false)
  capitalReductionPercent Decimal?
  insuranceOffering       String?
  forgiveAccruedInterest  Boolean        @default(false)
  forgiveFutureInterest   Boolean        @default(false)
  paymentOrder            Json?
  hasClassPrivileges      Boolean        @default(false)
  classPrivilegesDescription String?
  thirdPartyPaymentAuth   Boolean        @default(false)
  guaranteeSubstitution   Boolean        @default(false)
  
  // Sociedad Conyugal
  spouseName              String?
  spouseIdNumber          String?
  spouseAddress           String?
  spousePhone             String?
  spouseEmail             String?
  
  // Tarifa y Fundamentos
  requestedFee            String?
  legalFoundations        String?
  
  // Notificaciones
  notificationAddress     String?
  notificationPhone       String?
  notificationEmail       String?
  
  // Firma
  applicantSignatureName  String?
  applicantSignatureId    String?
  applicantSignature      String?
  
  assets                  Asset[]
  debtor                  Debtor         @relation(fields: [debtorId], references: [id])
  operator                User           @relation(fields: [operatorId], references: [id])
  tenant                  Tenant         @relation(fields: [tenantId], references: [id])
  debts                   Debt[]
  documents               Document[]
  legalProcesses          LegalProcess[]
  Notification            Notification[]
  libranzas               Libranza[]
  suspendedServices       SuspendedService[]
  dependents              Dependent[]
  
  @@unique([caseNumber, tenantId])
}

model Document {
  id                 String            @id @default(cuid())
  name               String
  type               String
  status             String
  uploadDate         DateTime          @default(now())
  url                String
  caseId             String
  tenantId           String
  case               Case              @relation(fields: [caseId], references: [id])
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  templateId         String?
  template           DocumentTemplate? @relation(fields: [templateId], references: [id])
  googleDriveId      String?
  fileName           String?
  mimeType           String?
  isGenerated        Boolean           @default(false)
  templateFolderPath String[]          @default([])
}

model DocumentTemplate {
  id             String     @id @default(cuid())
  googleDriveId  String
  fileName       String
  mimeType       String
  placeholders   Json
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  folderPath     String[]   @default([])
  parentFolderId String?
  isFolder       Boolean    @default(false)
  tenantId       String
  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  documents      Document[]
}

model DocumentFromDrive {
  id             String   @id @default(cuid())
  googleDriveId  String   
  fileName       String
  mimeType       String
  size           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  folderPath     String[] @default([])
  parentFolderId String?
  isFolder       Boolean  @default(false)
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  
  @@unique([googleDriveId, tenantId])
}

model Debtor {
  id               String    @id @default(cuid())
  name             String
  idNumber         String    
  idType           String
  email            String    
  phone            String
  address          String
  city             String
  department       String
  birthDate        DateTime?
  maritalStatus    String?
  occupation       String
  monthlyIncome    Decimal
  monthlyExpenses  Decimal?
  dependents       Int?
  educationLevel   String?
  totalDebt        Decimal
  emergencyContact String?
  emergencyPhone   String?
  bankAccount      String?
  bankName         String?
  accountType      String?
  description      String?
  activeCases      Int
  createdDate      DateTime  @default(now())
  lastUpdate       DateTime  @updatedAt
  tenantId         String
  
  // Additional income details
  otherIncomeDescription String?
  otherIncomeAmount      Decimal?
  hasEmployerCertification Boolean @default(false)
  
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  assets           Asset[]
  cases            Case[]
  debts            Debt[]
  
  @@unique([idNumber, tenantId])
  @@unique([email, tenantId])
}

model Debt {
  id           String   @id @default(cuid())
  amount       Decimal
  interestRate Float
  type         String
  caseId       String
  creditorId   String
  debtorId     String?
  tenantId     String
  
  // Detailed creditor information
  creditorAddress      String?
  creditorCity         String?
  creditorEmail        String?
  capitalAmount        Decimal?
  interestAmount       Decimal?
  isDeferred           Boolean  @default(false)
  documentType         String?
  grantDate            DateTime?
  dueDate              DateTime?
  creditClassification String?
  hasActiveLibranza    Boolean  @default(false)
  creditorClass        String?
  percentageOfTotal    Decimal?
  daysOverdue          Int?
  
  // Co-debtor/Guarantor info
  coDebtorName         String?
  coDebtorCity         String?
  coDebtorAddress      String?
  
  case         Case     @relation(fields: [caseId], references: [id])
  creditor     Creditor @relation(fields: [creditorId], references: [id])
  debtor       Debtor?  @relation(fields: [debtorId], references: [id])
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
}

model Asset {
  id       String  @id @default(cuid())
  name     String
  type     String
  value    Decimal
  caseId   String
  debtorId String?
  tenantId String
  
  // Real Estate specific fields
  propertyType          String?
  address               String?
  registrationNumber    String?
  encumbrance           String?
  affectation           String?
  precautionaryMeasure  String?
  proofDocument         String?
  isFamilyHome          Boolean @default(false)
  isInalienablePatrimony Boolean @default(false)
  
  // Personal Property specific fields  
  brand                 String?
  model                 String?
  condition             String?
  licensePlate          String?
  transitAuthority      String?
  guaranteeInFavorOf    String?
  guaranteeAmount       Decimal?
  material              String?
  description           String?
  
  case     Case    @relation(fields: [caseId], references: [id])
  debtor   Debtor? @relation(fields: [debtorId], references: [id])
  tenant   Tenant  @relation(fields: [tenantId], references: [id])
}

model Creditor {
  id                  String    @id @default(cuid())
  name                String
  type                String
  email               String    
  phone               String
  address             String
  representative      String
  nit                 String    
  website             String?
  city                String?
  department          String?
  bankName            String?
  createdDate         DateTime? @default(now())
  lastUpdate          DateTime? @updatedAt
  description         String?
  representativeId    String?
  representativeEmail String?
  representativePhone String?
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  contacts            Contact[]
  debts               Debt[]
  
  @@unique([email, tenantId])
  @@unique([nit, tenantId])
}

model Contact {
  id         String   @id @default(cuid())
  name       String
  role       String
  email      String
  phone      String
  creditorId String
  tenantId   String
  creditor   Creditor @relation(fields: [creditorId], references: [id])
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
}

model LegalProcess {
  id                    String   @id @default(cuid())
  description           String
  caseId                String
  tenantId              String
  processType           String?
  plaintiff             String?
  court                 String?
  fileNumber            String?
  precautionaryMeasure  String?
  case                  Case     @relation(fields: [caseId], references: [id])
  tenant                Tenant   @relation(fields: [tenantId], references: [id])
}

model User {
  id               String         @id @default(cuid())
  name             String
  email            String         
  lastLogin        DateTime?
  professionalCard String
  phone            String
  address          String
  createdDate      DateTime       @default(now())
  roleId           String
  password         String?
  tenantId         String
  assignedCases    Case[]
  role             Role           @relation(fields: [roleId], references: [id])
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  Notification     Notification[]
  
  @@unique([email, tenantId])
}

model Role {
  id          String           @id @default(cuid())
  name        String           
  description String
  color       String           @default("bg-gray-100 text-gray-800")
  tenantId    String
  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  users       User[]
  permissions RolePermission[]
  
  @@unique([name, tenantId])
}

model Permission {
  id        String           @id @default(cuid())
  name      String           
  category  String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  roles     RolePermission[]
  
  @@unique([name, tenantId])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  tenantId     String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  tenant       Tenant     @relation(fields: [tenantId], references: [id])

  @@unique([roleId, permissionId])
}

model Notification {
  id          String   @id @default(cuid())
  type        String
  title       String
  message     String
  userId      String
  caseId      String?
  relatedId   String?
  createdDate DateTime @default(now())
  tenantId    String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  case   Case?  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("notifications")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  tenantId  String
  expiresAt DateTime
  createdAt DateTime @default(now())
  used      Boolean  @default(false)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@map("password_reset_tokens")
}

model Libranza {
  id               String  @id @default(cuid())
  payerName        String
  payerAddress     String?
  payerEmail       String?
  payerPhone       String?
  deductedAmount   Decimal
  productAndCreditor String?
  caseId           String
  tenantId         String
  case             Case    @relation(fields: [caseId], references: [id])
  tenant           Tenant  @relation(fields: [tenantId], references: [id])
}

model SuspendedService {
  id             String  @id @default(cuid())
  creditorName   String
  address        String?
  email          String?
  phone          String?
  suspendedProduct String?
  amountOwed     Decimal
  caseId         String
  tenantId       String
  case           Case    @relation(fields: [caseId], references: [id])
  tenant         Tenant  @relation(fields: [tenantId], references: [id])
}

model Dependent {
  id           String @id @default(cuid())
  name         String
  age          Int
  relationship String
  caseId       String
  tenantId     String
  case         Case   @relation(fields: [caseId], references: [id])
  tenant       Tenant @relation(fields: [tenantId], references: [id])
}
