  anexaExtractosBancarios      Boolean   @default(false) @map("anexa_extractos_bancarios")
  anexaCertificadosDeuda       Boolean   @default(false) @map("anexa_certificados_deuda")
  anexaCertificadoTradicion    Boolean   @default(false) @map("anexa_certificado_tradicion")
  anexaRelacionProcesos        Boolean   @default(false) @map("anexa_relacion_procesos")
  anexaDeclaracionRenta        Boolean   @default(false) @map("anexa_declaracion_renta")
  anexaDocumentoIdentidad      Boolean   @default(false) @map("anexa_documento_identidad")

  // ============================================================
  // FORMULARIO DEFINITIVO - Sección XI: Información del Apoderado
  // ============================================================
  apoderadoNombreCompleto      String?   @map("apoderado_nombre_completo")
  apoderadoTipoIdentificacion  String?   @map("apoderado_tipo_identificacion")
  apoderadoIdentificacion      String?   @map("apoderado_identificacion")
  apoderadoTarjetaProfesional  String?   @map("apoderado_tarjeta_profesional")
  apoderadoDireccion           String?   @map("apoderado_direccion")
  apoderadoTelefono            String?   @map("apoderado_telefono")
  apoderadoCorreo              String?   @map("apoderado_correo")
  existePoderOtorgado          Boolean   @default(false) @map("existe_poder_otorgado")

  // ============================================================
  // FORMULARIO DEFINITIVO - Sección XII: Datos Radicación Interna (sistema)
  // ============================================================
  expedienteNumero             String?   @map("expediente_numero")
  expedienteAnio               Int?      @map("expediente_anio")
  fechaRadicacion              DateTime? @map("fecha_radicacion_interna")
  centroConciliacionNombre     String?   @map("centro_conciliacion_nombre")
  conciliadorAsignado          String?   @map("conciliador_asignado")
  ciudadRadicacion             String?   @map("ciudad_radicacion")

  // ============================================================
  // Relations
  // ============================================================
  assets                  Asset[]
  debtor                  Debtor         @relation(fields: [debtorId], references: [id])
  operator                User           @relation(fields: [operatorId], references: [id])
  tenant                  Tenant         @relation(fields: [tenantId], references: [id])
  debts                   Debt[]
  documents               Document[]
  legalProcesses          LegalProcess[]
  Notification            Notification[]
  libranzas               Libranza[]
  suspendedServices       SuspendedService[]
  dependents              Dependent[]
  // Nuevos modelos del formulario definitivo
  acreedores              Acreedor[]
  bienes                  Bien[]
  procesosJudiciales      ProcesoJudicial[]
  apoderados              Apoderado[]
  payments                Payment[]
  generationRequests      DocumentGenerationRequest[]

  @@unique([caseNumber, tenantId])
}

model Document {
  id                 String            @id @default(cuid())
  name               String
  type               String
  status             String
  uploadDate         DateTime          @default(now())
  url                String
  caseId             String
  tenantId           String
  case               Case              @relation(fields: [caseId], references: [id])
  tenant             Tenant            @relation(fields: [tenantId], references: [id])
  templateId         String?
  template           DocumentTemplate? @relation(fields: [templateId], references: [id])
  googleDriveId      String?
  fileName           String?
  mimeType           String?
  isGenerated        Boolean           @default(false)
  templateFolderPath String[]          @default([])
  // Sectioned-layout (v1) classification: GENERADO | ADJUNTO | EVIDENCIA | HISTORIAL
  section            String?           @map("section")
  // Versioning: when a generated doc is regenerated, the previous one is archived and points here.
  supersededById     String?           @map("superseded_by_id")
  supersededBy       Document?         @relation("DocumentVersion", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes         Document[]        @relation("DocumentVersion")

  @@index([caseId, section])
}

