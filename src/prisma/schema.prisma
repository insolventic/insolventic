  concHoraProgramada                   String?   @map("conc_hora_programada")
  // Causa de terminación / resultado (enum-like: mutual-exclusive flags)
  concCausaTerminacion                 String?   @map("conc_causa_terminacion")
  concResultadoInforme                 String?   @map("conc_resultado_informe")
  // JSON arrays for repeatable sections (handlebars-lite {{#each}})
  concMenoresAlimentos                 Json?     @map("conc_menores_alimentos")
  concMenoresUnion                     Json?     @map("conc_menores_union")
  concClausulasAdicionalesAlimentos    Json?     @map("conc_clausulas_adicionales_alimentos")
