  gastosAlimentacion           Decimal?  @map("gastos_alimentacion")
  gastosServiciosPublicos      Decimal?  @map("gastos_servicios_publicos")
  gastosTransporte             Decimal?  @map("gastos_transporte")
  gastosEducacion              Decimal?  @map("gastos_educacion")
  gastosSalud                  Decimal?  @map("gastos_salud")
  otrosGastos                  Decimal?  @map("otros_gastos")
  totalGastosMensuales         Decimal?  @map("total_gastos_mensuales")
  // Capacidad económica
