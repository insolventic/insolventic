  apoyoPrestadorTipoId                 String?   @map("apoyo_prestador_tipo_id")
  apoyoPrestadorId                     String?   @map("apoyo_prestador_id")
  apoyoPrestadorDireccion              String?   @map("apoyo_prestador_direccion")
  apoyoPrestadorCiudad                 String?   @map("apoyo_prestador_ciudad")
  apoyoPrestadorCorreo                 String?   @map("apoyo_prestador_correo")
  apoyoPrestadorCel                    String?   @map("apoyo_prestador_cel")
  apoyoPrestadorRelacion               String?   @map("apoyo_prestador_relacion")
  // Conciliadora asignada
  apoyoConciliadoraName                String?   @map("apoyo_conciliadora_name")
  apoyoConciliadoraCC                  String?   @map("apoyo_conciliadora_cc")
  apoyoConciliadoraTP                  String?   @map("apoyo_conciliadora_tp")
  // Acuerdo y resultado
  apoyoAcuerdo                         String?   @map("apoyo_acuerdo") @db.Text
  apoyoResultado                       String?   @map("apoyo_resultado") @db.Text
  apoyoCausaTerminacion                String?   @map("apoyo_causa_terminacion")
  // Cláusulas del acuerdo (JSON array: [{NUMERO_CLAUSULA, TEXTO_CLAUSULA}])
  apoyoClausulas                       Json?     @map("apoyo_clausulas")

  // ============================================================
  // FORMULARIO DEFINITIVO - Sección IX: Propuesta Inicial de Pago
  // ============================================================
  propuestaPlazoMeses          Int?      @map("propuesta_plazo_meses")
  propuestaPeriodicidadPago    String?   @map("propuesta_periodicidad_pago")
  propuestaTasaInteres         Decimal?  @map("propuesta_tasa_interes")
  propuestaQuitaPromedio       Decimal?  @map("propuesta_quita_promedio")
  propuestaFechaInicioPago     DateTime? @map("propuesta_fecha_inicio_pago")
  propuestaObservaciones       String?   @map("propuesta_observaciones")

