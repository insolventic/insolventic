  apoyoBeneficiarioId                  String?   @map("apoyo_beneficiario_id")
  apoyoBeneficiarioDireccion           String?   @map("apoyo_beneficiario_direccion")
  apoyoBeneficiarioCiudad              String?   @map("apoyo_beneficiario_ciudad")
  apoyoBeneficiarioCorreo              String?   @map("apoyo_beneficiario_correo")
  apoyoBeneficiarioCel                 String?   @map("apoyo_beneficiario_cel")
  // Prestador de apoyo (quien se compromete)
