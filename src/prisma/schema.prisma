  concApoderadoConvocanteTipoId        String?   @map("conc_apoderado_convocante_tipo_id")
  concApoderadoConvocanteId            String?   @map("conc_apoderado_convocante_id")
  concApoderadoConvocanteDireccion     String?   @map("conc_apoderado_convocante_direccion")
  concApoderadoConvocanteCiudad        String?   @map("conc_apoderado_convocante_ciudad")
  concApoderadoConvocanteCorreo        String?   @map("conc_apoderado_convocante_correo")
  concApoderadoConvocanteCel           String?   @map("conc_apoderado_convocante_cel")
  concApoderadoConvocanteTP            String?   @map("conc_apoderado_convocante_tp")
  // Apoderado convocado
