generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// `url` es la conexión que usa la app en runtime: va por el pooler de Neon
// (host con `-pooler`), que es lo correcto en serverless — muchas invocaciones
// cortas, sin conexiones persistentes.
//
// `directUrl` es la conexión sin pooler, y la usan SOLO los comandos de
// migración (`migrate deploy`, `migrate dev`, `db push`, `migrate diff`).
// PgBouncer en modo transacción no sostiene la sesión persistente ni los
// advisory locks que necesita `migrate deploy`, y lo rechaza con:
//
//     Error: P1002 — The database server was reached but timed out.
//
// Ese error tumbó deploys de producción de forma intermitente (`702e9ff`
// recuperado al reintentar, `cc33d2e` no), porque el `buildCommand` de
// vercel.json corre `prisma migrate deploy` solo cuando VERCEL_ENV=production.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id              String    @id @default(cuid())
  name            String    @unique
  slug            String    @unique
  description     String?
  logoUrl         String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  cases               Case[]
  debtors             Debtor[]
  creditors           Creditor[]
  users               User[]
  roles               Role[]
  permissions         Permission[]
  rolePermissions     RolePermission[]
  notifications       Notification[]
  documents           Document[]
  documentTemplates   DocumentTemplate[]
  documentsFromDrive  DocumentFromDrive[]
  passwordResetTokens PasswordResetToken[]
  contacts            Contact[]
  legalProcesses      LegalProcess[]
  debts               Debt[]
  assets              Asset[]
  libranzas           Libranza[]
  suspendedServices   SuspendedService[]
  dependents          Dependent[]
  // Nuevos modelos del formulario definitivo
  acreedores          Acreedor[]
  bienes              Bien[]
  procesosJudiciales  ProcesoJudicial[]
  apoderados          Apoderado[]
  auditLogs           AuditLog[]
  payments            Payment[]
  conciliationCenters ConciliationCenter[]
  generationRequests  DocumentGenerationRequest[]
}

/// Centro de Conciliación — escalable, reemplaza el mapping hard-coded.
/// El driveFolderName es la ruta de carpeta L2 dentro de Drive.
model ConciliationCenter {
  id              String   @id @default(cuid())
  tenantId        String
  code            String   // identificador estable, ej. "armonia"
  displayName     String
  driveFolderName String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
}

model Case {
  id                      String         @id @default(cuid())
  caseNumber              String
  debtorName              String
  type                    String
  totalDebt               Decimal
  creditors               Int
  createdDate             DateTime       @default(now())
  hearingDate             DateTime?
  phase                   String?
  causes                  String[]       @default([])
  otherCauseDetail        String?
  debtorId                String
  operatorId              String
  tenantId                String
  tramite                 String?
  filingDate              DateTime?
  debtorIdNumber          String?
  convened                String?
  attorney                String?
  owedCapital             Decimal?
  designatedOperator      String?
  designationDate         DateTime?
  positionAcceptanceDate  DateTime?
  inadmissionDate         DateTime?
  admissionDate           DateTime?
  firstHearingDate        DateTime?
  firstHearingTime        String?
  rejection               Boolean        @default(false)
  withdrawal              Boolean        @default(false)
  hasLegalProcesses       Boolean        @default(false)
  courtNumber             String?
  city                    String?
  processType             String?
  plaintiff               String?
  judicialFileNumber      String?
  suspensionDate          DateTime?
  resultDeliveryDate      DateTime?
  resultType              String?
  resultDate              DateTime?
  siccacNumber            String?
  riskCenterCommunication Boolean        @default(false)

  // Ámbito de Aplicación (legacy)
  applicantScope          String[]       @default([])

  // Propuesta de Pago (legacy - campos existentes conservados)
  gracePeriodRequested    Boolean        @default(false)
  gracePeriodMonths       Int?
  paymentInKind           Boolean        @default(false)
  paymentInKindDescription String?
  assetSaleAuthorized     Boolean        @default(false)
  assetSaleDescription    String?
  cashFlowPayment         Boolean        @default(false)
  paymentTermMonths       Int?
  monthlyPaymentAmount    Decimal?
  variablePayment         Decimal?
  extraordinaryPayment    Boolean        @default(false)
  extraordinaryPaymentDate String?
  capitalReduction        Boolean        @default(false)
  capitalReductionPercent Decimal?
  insuranceOffering       String?
  forgiveAccruedInterest  Boolean        @default(false)
  forgiveFutureInterest   Boolean        @default(false)
  paymentOrder            Json?
  hasClassPrivileges      Boolean        @default(false)
  classPrivilegesDescription String?
  thirdPartyPaymentAuth   Boolean        @default(false)
  guaranteeSubstitution   Boolean        @default(false)

  // Sociedad Conyugal (legacy)
  spouseName              String?
  spouseIdNumber          String?
  spouseAddress           String?
  spousePhone             String?
  spouseEmail             String?

  // Tarifa y Fundamentos (legacy)
  requestedFee            String?
  legalFoundations        String?

  // Notificaciones (legacy)
  notificationAddress     String?
  notificationCity        String?
  notificationPhone       String?
  notificationEmail       String?

  // Firma (legacy)
  applicantSignatureName  String?
  applicantSignatureId    String?
  applicantSignature      String?

  // Zoom Meeting Info (legacy)
  zoomMeetingId           String?
  zoomPassword            String?
  zoomLink                String?

  // Google Drive folder for case documents
  driveFolderId           String?
  // Storage layout version: 0 = legacy flat, 1 = sectioned (01-Generados / 02-Adjuntos / 03-Evidencias / 04-Historial)
  layoutVersion           Int       @default(0) @map("layout_version")
  // Optimistic locking: incremented on every update, checked before write
  version                 Int       @default(0)

  // Campos de ingresos/gastos del caso legacy
  monthlyIncome           Decimal?
  monthlyExpenses         Decimal?
  otherIncomeDescription  String?
  otherIncomeAmount       Decimal?
  hasEmployerCertification Boolean  @default(false)

  // Post-Acuerdo - Fechas y datos de resultado
  paymentStartDate        DateTime?
  agreementValidityDate   DateTime?
  approvalPercentage      Decimal?

  // Fracaso - Datos específicos
  failureDate             DateTime?
  failureType             String?

  // Acuerdo Bilateral
  isBilateral             Boolean   @default(false)
  bilateralAgreementNumber String?
  bilateralCreditorId     String?

  // ============================================================
  // FORMULARIO DEFINITIVO - Sección II: Cónyuge
  // ============================================================
  conyugeTipoIdentificacion    String?   @map("conyuge_tipo_identificacion")
  conyugeIdentificacion        String?   @map("conyuge_identificacion")
  conyugePrimerNombre          String?   @map("conyuge_primer_nombre")
  conyugeSegundoNombre         String?   @map("conyuge_segundo_nombre")
  conyugePrimerApellido        String?   @map("conyuge_primer_apellido")
  conyugeSegundoApellido       String?   @map("conyuge_segundo_apellido")
  conyugeNombreCompleto        String?   @map("conyuge_nombre_completo")
  conyugeTelefono              String?   @map("conyuge_telefono")
  conyugeCorreo                String?   @map("conyuge_correo")
  sociedadConyugalDisuelta     Boolean   @default(false) @map("sociedad_conyugal_disuelta")

  // ============================================================
  // FORMULARIO DEFINITIVO - Sección III: Información Laboral y Económica
  // ============================================================
  deudorOcupacion              String?   @map("deudor_ocupacion")
  deudorProfesion              String?   @map("deudor_profesion")
  deudorActividadEconomica     String?   @map("deudor_actividad_economica")
  deudorTipoVinculacion        String?   @map("deudor_tipo_vinculacion")
  deudorNombreEmpleador        String?   @map("deudor_nombre_empleador")
  deudorNitEmpleador           String?   @map("deudor_nit_empleador")
  // Ingresos
  ingresoPrincipalMensual      Decimal?  @map("ingreso_principal_mensual")
  otrosIngresosMensuales       Decimal?  @map("otros_ingresos_mensuales")
  totalIngresosMensuales       Decimal?  @map("total_ingresos_mensuales")
  ingresosVariablesPromedio    Decimal?  @map("ingresos_variables_promedio")
  ingresosNoOperacionales      Decimal?  @map("ingresos_no_operacionales")
  // Gastos
